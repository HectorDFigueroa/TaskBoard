# Copiar como .env para desarrollo local (el archivo .env NO se sube a GitHub)

PORT=3000

# Local: su PostgreSQL instalado. En Render: la Internal Database URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quien_me_debe

# true si se conectan a Render desde su PC (External URL). En Render con la Internal URL: false
DB_SSL=false

# URL del frontend permitida por CORS (en Render: la URL del Static Site)
FRONTEND_URL=http://localhost:5173

# Secreto para firmar los tokens. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio

# RN-07: tasa de usura vigente, efectiva anual en % (ej. 25.5).
# Consultar el valor certificado por la Superintendencia Financiera.
# Si se deja vacía, no se valida el límite de usura.
TASA_USURA_EA=
